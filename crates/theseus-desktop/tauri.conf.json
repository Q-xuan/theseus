{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Theseus",
  "version": "0.8.0",
  "identifier": "dev.theseus.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": false,
    "category": "DeveloperTool",
    "shortDescription": "Theseus desktop — Codex-density shell over pi --mode rpc",
    "longDescription": "Local window over `pi --mode rpc`. Double-click opens the window. Keys and providers stay inside pi. Windows needs `pi` on PATH. No updater or store signature requirement.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
